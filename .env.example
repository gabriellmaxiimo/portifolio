# Copie para .env.local e preencha com suas próprias credenciais.
# Nunca use o prefixo VITE_ para segredos; eles são lidos apenas no servidor.

# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Opcional: trocar o modelo (padrão: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

SPOTIFY_CLIENT_ID=seu_client_id
SPOTIFY_CLIENT_SECRET=seu_client_secret
SPOTIFY_REFRESH_TOKEN=

# TMDB Read Access Token (somente no servidor; não use prefixo VITE_)
TMDB_API_READ_ACCESS_TOKEN=

# Supabase: URL e anon key são públicas; a segurança depende das políticas RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=